{
  "model": {
    "vocab_size": 10000,
    "context_length": 256,
    "num_layers": 4,
    "d_model": 512,
    "num_heads": 16,
    "max_seq_len": 256,
    "theta": 10000.0,
    "d_ff": 1344
  },
  "optimizer": {
    "learning_rate": 0.001,
    "min_learning_rate": 0.0001,
    "warmup_iters": 10,
    "weight_decay": 0.01,
    "beta1": 0.9,
    "beta2": 0.999,
    "eps": 1e-8,
    "max_grad_norm": 1.0
  },
  "data": {
    "use_memmap": true,
    "train_path": "data/tinystories_sample_tokens.npy",
    "synthetic_num_tokens": 128
  },
  "checkpoint": {
    "path": "unit_tests/tmp_train_checkpoint.pt",
    "save_interval": 5
  },
  "logging": {
    "log_interval": 1,
    "log_file": "unit_tests/tmp_train.log"
  },
  "batch_size": 2,
  "total_steps": 2,
  "device": "mps",
  "seed": 1150
}
