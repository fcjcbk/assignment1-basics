{
  "model": {
    "vocab_size": 10000,
    "context_length": 256,
    "num_layers": 4,
    "d_model": 512,
    "num_heads": 16,
    "max_seq_len": 256,
    "theta": 10000.0,
    "d_ff": 1344
  },
  "optimizer": {
    "learning_rate": 0.001,
    "min_learning_rate": 0.0001,
    "warmup_iters": 10,
    "weight_decay": 0.01,
    "beta1": 0.9,
    "beta2": 0.999,
    "eps": 1e-8,
    "max_grad_norm": 1.0
  },
  "data": {
    "use_memmap": true,
    "train_path": "data/TinystoriesV2-GPT4-train.npy",
    "synthetic_num_tokens": 128
  },
  "run": {
    "name": null
  },
  "checkpoint": {
    "path": "data/checkpoint/train_checkpoint.pt",
    "save_interval": 1000
  },
  "logging": {
    "log_interval": 100,
    "log_file": "log/train.log"
  },
  "eval": {
    "valid_path": "data/TinyStoriesV2-GPT4-valid.npy",
    "interval": 100,
    "mode": "sampled",
    "num_batches": 50,
    "batch_size": null
  },
  "plot": {
    "enabled": true,
    "path": "log/loss_curve.png",
    "interval": 100,
    "width": 1000,
    "height": 720,
    "dpi": 120,
    "show": true,
    "pause_seconds": 0.001
  },
  "tensorboard": {
    "enabled": true,
    "log_dir": "log/tensorboard",
    "interval": 100,
    "flush_secs": 30
  },
  "batch_size": 32,
  "total_steps": 40000,
  "device": "mps",
  "seed": 1150
}
